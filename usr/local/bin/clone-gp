#!/usr/bin/perl
# this script clones a list of packages or the default list from github into
# their respective directories with correct remote names ie name.rem
# For the list of packages first check if it has been cloned already.
# If it has been cloned check it has the latest updates with pull -v --ffonly --all
# If no command line parameters are given then clone the internal list
# if at least one package is listed on the command line then clone
# only the command line parameters.
# command line switches
# -h heltp
# -p list of packages to clone
# -D default list of packages to clone
# -b branch select
# -u url http or directory
# -d target root directory

use strict;
use warnings;
use Getopt::Std;
use File::Path qw (make_path);

# global vars
our ($opt_h, $opt_p, $opt_d, $opt_b, $opt_u, $opt_D, $opt_l);

#######################################################
# sub get list of git hub projects
# each line:
# rob54321/project_name description .....
# strip leading rob54321/
# and strip from white space to end
# parameters passed: ref to empty list
#######################################################
sub getdefaultlist {
	my $refdefault_list = shift @_;

	my @ghlist = `gh repo list`;
	chomp(@ghlist);
	foreach my $line (@ghlist) {
		$line =~ s/^rob54321\///;
		$line =~ s/\s+.*$//;
		push (@$refdefault_list, $line);
	}
}

#####################################################
# sub: print the default list from github
# parameters passed ref to list
#####################################################
sub printdefaultlist {
	# get the default list
	my @default_list = ();
	# get default list
	getdefaultlist(\@default_list);
	foreach my $item (@default_list) {
		print "$item\n";
	}
}
#####################################################
# sub : isiteminlist list, item
# this sub check if the item is in the list.
# it returns true if the item is in the list
# and false otherwise
# parameters: ref to list , item
#####################################################
sub iteminlist {
	# get parameters
	my $listref = shift @_;
	my $item = shift @_;
	
	# check list for item
	foreach my $litem (@$listref) {
		if ($item eq $litem) {
			# item is in the list
			print "itemlist: found $litem\n";
			return 1;
		}
	}
	# item was not found
	# return false
	return 0;
}

# default parameters
my $default_branch = "dev";

# default target root directory
my $default_target_directory = "/home/robert";

# default url
my $default_url = "https://github.com/rob54321";

# help function
sub usage {
print "-p is a list of packages: \"pkg1 pkg2 ....\" to clone instead of internal list\n";
print "-b branch, the default is $default_branch\n";
print "-u url, the default is https://github.com/rob54321\n";
print "-d target root directory, default is $default_target_directory\n";
print "-D clones the default list:\n";

# print the default list
printdefaultlist;

print "-l list projects on github\n";
print "-h this help\n";
exit 0;
}

###################################################################################
# main entry
###################################################################################

# count the no of command line arguments
# so if count is 0 then show usage
my $no_arg = @ARGV;

# get command line parameters
getopts('hd:p:b:u:Dl');

# show help for -h or if no command line arguments given
if ($opt_h or $no_arg == 0) {
	usage;
}

# print the default list if -l given
printdefaultlist if ($opt_l);

# make a list of packages to clone from git
# if -p and -D are given append -p list to the -D list in @list
my @list = ();

# get the default list if -D or -l given
my @default_list = ();
if ($opt_D) {
	getdefaultlist(\@default_list);
    # use the default list if -D given
	@list = @default_list if $opt_D;
}

# if extra packages are given
# append them to the list
# if they are not in the list

if ($opt_p) {
	# make a list of individual parameters
	my @plist = split (/ /, $opt_p);
	chomp (@plist);
	# check if the items in p list are in list, if not, append it
	# is the @list empty
	if (scalar(@list) eq 0) {
		# list is empty add all items
		@list = @plist;
	} else {
		# list is not empty
		# only add a plist item if
		# it is not in the list
		foreach my $pitem (@plist) {
			push (@list, $pitem) unless iteminlist(\@list, $pitem);
		}
	}
}

# set the target root directory
my $target_dir;
if ($opt_d) {
	# -d has a parameter
	$target_dir = $opt_d;
	make_path ($target_dir) unless -d $target_dir;
} else {
	# there is no parameter use the default
	$target_dir = $default_target_directory;
}

# set the branch if the default parameter was not used
my $branch;
if ($opt_b) {
	# -b has a parameter
	$branch = $opt_b;
} else {
	# -b does not have a parameter
	$branch = $default_branch;
}

# set url for cloning
my $url;
# extension for remote either .rem .local
my $remote_extension;

if ($opt_u) {
	# -u has a parameter
	# check if it is local or remote
	# so the remote_extension can be set
	if ($opt_u =~ /^http/) {
		# remote url
		$remote_extension = ".rem";
	} elsif (-d $opt_u) {
		# url is a local directory
		$remote_extension = ".local";
	} else {
		# the url does not exist
		die "The url $opt_u does not exist\n";
	}
	# set the url
	$url = $opt_u;
} else {
	# -u does not have a parameter
	# use the default github which is remote
	$url = $default_url;
	# set the remote extension to remote for github
	$remote_extension = ".rem";
}

# for each item in the list, clone it unless it is already cloned.
# if it is clones check it is updated with git pull -v --ff-only --all
my $rc;
foreach my $item (@list) {
	# check if directory item exists, package name = directory name
	chdir $target_dir;
	if (-d $item) {
		# directory exists, check for updates
		print "Directory $item exists, checking for updates\n";
		# change directory to item
		chdir "$item";
		$rc =system("git pull -v --ff-only --all");
		# check for errors
		print "Error updating $item\n" if $rc !=0;
		# change back to home
		chdir "..";
		# print a blank line
		print "-------------------------------------------------\n";
		print "\n";
	} else {
		# the directory does not exist
		# clone the item
		print "branch = $branch\n";
		$rc = system("git clone -o $item" . "$remote_extension -v -b $branch $url/$item.git $item");
		print "Error cloning $item\n" if $rc != 0;
		print "-------------------------------------------------\n";
		print "\n";
	}
}
