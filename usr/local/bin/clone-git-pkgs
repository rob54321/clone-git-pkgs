#!/usr/bin/perl
# this script clones a list of packages or the default list from github into
# their respective directories with correct remote names ie name.rem
# For the list of packages first check if it has been cloned already.
# If it has been cloned check it has the latest updates with pull -v --ffonly --all
# If no command line parameters are given then clone the internal list
# if at least one package is listed on the command line then clone
# only the command line parameters.
# command line switches
# -h heltp
# -p list of packages to clone
# -d default list of packages to clone

use strict;
use warnings;
use Getopt::Std;

# global vars
our ($opt_h, $opt_p, $opt_d, $opt_b, $opt_u);

# default list
my @default_list = ("initialise-linux",
					"configdata",
					"configdatarpi",
					"thunderbirddatarpi",
					"thunderbirdconfig",
					"confignotes",
					"builddebiantree",
					"makelive",
					"editfstab",
					"stedit",
					"rpi-install",
					"ubuntu-install");

# default parameters
my $default_branch = "dev";

# default url
my $default_url = "https://github.com/rob54321";

# help function
sub usage {
print "-p is a list of packages: \"pkg1 pkg2 ....\" to clone instead of internal list\n";
print "-b branch, the default is dev\n";
print "-u url, the default is https://github.com/rob54321\n";
print "-d clones the default list:\n";
print		"\tinitialise-linux\n";
print		"\tconfigdata\n";
print		"\tconfigdatarpi\n";
print		"\tthunderbirddatarpi\n";
print		"\tthunderbirdconfig\n";
print		"\tconfignotes\n";
print		"\tbuilddebiantree\n";
print		"\tmakelive\n";
print		"\teditfstab\n";
print		"\tstedit\n";
print		"\trpi-install\n";
print		"\tubuntu-install\n";
print "-h this help\n";
exit 0;
}

###################################################################################
# main entry
###################################################################################

# set the default parameters
# defaultparameter;

# get command line parameters
getopts('hdp:b:u:');

# show help
usage if $opt_h;

# make a list of packages to clone from git
# if -p and -d are given only -p will be done
my @list;
if ($opt_p) {
	# make a list of individual parameters
	@list = split (/ /, $opt_p);
 } elsif ($opt_d) {
	# use default list
	@list = @default_list;
}

# set the branch if the default parameter was not used
my $branch;
if ($opt_b) {
	# -b has a parameter
	$branch = $opt_b;
} else {
	# -b does not have a parameter
	$branch = $default_branch;
}

# set url for cloning
my $url;
# extension for remote either .rem .local
my $remote_extension;

if ($opt_u) {
	# -u has a parameter
	# check if it is local or remote
	# so the remote_extension can be set
	if ($opt_u =~ /^http/) {
		# remote url
		$remote_extension = ".rem";
	} elsif (-d $opt_u) {
		# url is a local directory
		$remote_extension = ".local";
	} else {
		# the url does not exist
		die "The url $opt_u does not exist\n";
	}
	# set the url
	$url = $opt_u;
} else {
	# -u does not have a parameter
	# use the default github which is remote
	$url = $default_url;
	# set the remote extension to remote for github
	$remote_extension = ".rem";
}

# for each item in the list, clone it unless it is already cloned.
# if it is clones check it is updated with git pull -v --ff-only --all
my $rc;
foreach my $item (@list) {
	# check if directory item exists, package name = directory name
	chdir "/home/robert";
	if (-d $item) {
		# directory exists, check for updates
		print "Directory $item exists, checking for updates\n";
		# change directory to item
		chdir "$item";
		$rc =system("git pull -v --ff-only --all");
		# check for errors
		print "Error updating $item\n" if $rc !=0;
		# change back to home
		chdir "..";
		# print a blank line
		print "-------------------------------------------------\n";
		print "\n";
	} else {
		# the directory does not exist
		# clone the item
		print "branch = $branch\n";
		$rc = system("git clone -o $item" . "$remote_extension -v -b $branch $url/$item.git $item");
		print "Error cloning $item\n" if $rc != 0;
		print "-------------------------------------------------\n";
		print "\n";
	}
}
