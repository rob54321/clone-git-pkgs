#!/usr/bin/perl
# this script clones a list of packages or the default list from github into
# their respective directories with correct remote names ie name.rem
# For the list of packages first check if it has been cloned already.
# If it has been cloned check it has the latest updates with pull -v --ffonly --all
# If no command line parameters are given then clone the internal list
# if at least one package is listed on the command line then clone
# only the command line parameters.
# command line switches
# -h heltp
# -p list of packages to clone
# -d default list of packages to clone

use strict;
use warnings;
use Getopt::Std;

# global vars
our ($opt_h, $opt_p, $opt_d);

# default list
my @default_list = ("initialise-linux",
					"configdata",
					"configdatarpi",
					"thunderbirddatarpi",
					"thunderbirdconfig",
					"confignotes",
					"builddebiantree",
					"makelive",
					"editfstab",
					"stedit",
					"rpi-install",
					"ubuntu-install");
# help function
sub usage {
print "-p is a list of packages: \"pkg1 pkg2 ....\" to clone instead of internal list\n";
print "-d clones the default list:\n";
print		"\tinitialise-linux\n";
print		"\tconfigdata\n";
print		"\tconfigdatarpi\n";
print		"\tthunderbirddatarpi\n";
print		"\tthunderbirdconfig\n";
print		"\tconfignotes\n";
print		"\tbuilddebiantree\n";
print		"\tmakelive\n";
print		"\teditfstab\n";
print		"\tstedit\n";
print		"\trpi-install\n";
print		"\tubuntu-install\n";
print "-h this help\n";
exit 0;
}

###################################################################################
# main entry
###################################################################################

# get command line parameters
getopts('hdp:');

# show help
usage if $opt_h;

# make a list of packages to clone from git
# if -p and -d are given only -p will be done
my @list;
if ($opt_p) {
	# make a list of individual parameters
	@list = split (/ /, $opt_p);
 } elsif ($opt_d) {
	# use default list
	@list = @default_list;
}

# for each item in the list, clone it unless it is already cloned.
# if it is clones check it is updated with git pull -v --ff-only --all
my $rc;
foreach my $item (@list) {
	# check if directory item exists, package name = directory name
	chdir "/home/robert";
	if (-d $item) {
		# directory exists, check for updates
		print "Directory $item exists, checking for updates\n";
		$rc =system("git -v --ff-only --all");
		
		# check for errors, maybe the directory is not a git directory
		# print a error message if there is one.
	} else {
		# the directory does not exist
		# clone the item
		$rc = system("git clone -o $item.rem -v -b dev https://github.com/rob54321/$item.git $item");
	}
}
